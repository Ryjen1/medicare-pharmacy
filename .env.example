NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Mailgun API (you can use a Resend API key here — e.g. re_xxxxxxxxxxxx)
MAILGUN_API_KEY=re_YOUR_RESEND_API_KEY

# Mailgun domain (not used by Resend, but kept for compatibility)
MAILGUN_DOMAIN=mg.yourdomain.com

# From address — for Resend use your verified domain, or onboarding@resend.dev for testing
MAILGUN_FROM="MediCare <onboarding@resend.dev>"

NEXT_PUBLIC_SITE_URL=http://localhost:3000
